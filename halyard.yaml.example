# Everything Halyard needs on this machine: what it talks to, and who it
# talks for.
#
# Copy to `halyard.yaml` and edit. It is gitignored, along with every backup
# Halyard takes of it, because the bot token lives here.
#
# `halyard init` writes this file for you and can wire a project afterwards.
# Editing it by hand is the same thing more slowly. For the smallest file that
# works — one project, one agent, one chat — start from
# `halyard.simple.yaml.example`; this one describes everything.
#
# A real environment variable still wins over anything below — that is how a
# container passes a token in without writing it to disk. There is no second
# file: `.env` used to hold the settings while this held the agents, which meant
# two files describing one machine and no rule for which of them won.

settings:
  # Where approvals go. `telegram` is the only one that asks a person.
  HALYARD_CHANNEL: telegram

  # From @BotFather. Secret — this is the line the gitignore is for.
  TELEGRAM_BOT_TOKEN: "123456:replace-me"
  # Where anything unrouted lands.
  TELEGRAM_CHAT_ID: "-1001234567890"
  # Only these Telegram users can answer an approval. Everyone else is
  # refused and the attempt is written to the audit log.
  TELEGRAM_AUTHORIZED_USER_IDS: "11111111"

  # The credential the turns Halyard starts run on.
  #
  # Without this they use the login you made at the keyboard, and that login
  # expires and cannot always be refreshed — which stops remote deliveries
  # until somebody signs in at the desk, the one thing you are away from.
  #
  # Mint one with:  claude setup-token
  # It uses your subscription rather than pay-as-you-go API billing, and lasts
  # about a year. Secret, like the token above — this is what the gitignore is
  # for. A session you drive at the keyboard is untouched by this.
  #
  # HALYARD_CLAUDE_OAUTH_TOKEN: "sk-ant-oat01-replace-me"
  #
  # Note: ANTHROPIC_API_KEY, if it is set anywhere in the environment, outranks
  # the token and bills the API instead of your plan. `halyard doctor` says so.

  # What a ZCode agent's turns pay with, and which model they run. ZCode's engine
  # keeps no credential when something else drives it: it asks Halyard for the
  # model call's header, and this is the answer. A coding-plan key from Z.AI's
  # console is the long-lived kind; the application's own login is short-lived,
  # and refreshing it from here would log the desk out. Without these two a
  # ZCode agent still approves and replies, but takes its messages at the desk.
  #
  # ZCODE_TOKEN: "replace-me"
  # ZCODE_MODEL: account:zai-individual-coding-plan/GLM-5.3-Flash
  # ZCODE_REASONING: max

  # What a card calls this codebase.
  CLAUDE_PROJECT_NAME: alpha-engine

  # The address the control plane binds, and the one every hook derives from.
  HALYARD_BIND: 127.0.0.1:8787

  # An approval nobody answers in this many seconds is DENIED, not left
  # waiting. These three have to stay in this order — the control plane
  # refuses to start otherwise — so a hook cannot give up before the person
  # it is waiting for has had their time.
  HALYARD_APPROVAL_TIMEOUT_SECONDS: 300
  HALYARD_BRIDGE_TIMEOUT_SECONDS: 330
  HALYARD_HOOK_TIMEOUT_SECONDS: 600

  # Serving holds an idle-sleep assertion on macOS, because a control plane
  # that sleeps denies every command on the machine and says nothing.
  # HALYARD_KEEP_AWAKE: false

  # Let a shell command through without a card when it is a read the gate
  # understands whole: every part a known read (`grep`, `sed -n`, `git log`…)
  # with options that only read, nothing it cannot parse (`$VAR`, `$(…)`, a
  # heredoc, a redirect into a file), and every path inside the project and
  # not a file that may hold a secret. A project's own `runs:` count as well.
  # Anything else is a card, as before. Off unless set; `low` is the only
  # value it takes.
  # HALYARD_ALLOW_RISK_AT_OR_BELOW: low

  # Keep every inspection run in the database — what the model was given, word
  # for word, and what it said — to compare models on the same input later.
  # Off unless set, because it is the one place Halyard keeps text: the input
  # holds the reply that was inspected. See docs/transitions.md.
  # HALYARD_KEEP_INSPECTIONS: true

  # The model every inspection runs on, and how hard it thinks: low, medium,
  # high, xhigh or max. Sonnet unless set, at the runtime's own effort for the
  # model — which is not the same for every model. An inspection can name its
  # own under the project's `inspections:`.
  # HALYARD_INSPECTION_MODEL: sonnet
  # HALYARD_INSPECTION_EFFORT: max

  # How much the log says. INFO unless set; DEBUG says more. A level that does
  # not exist refuses to start rather than quietly logging at INFO.
  # HALYARD_LOG_LEVEL: DEBUG

# Paths the agent may write to without being asked.
#
# The gate covers `Write` and `Edit`, so a write to anywhere else puts a card
# on your phone rather than failing — which is what a turn started from the
# phone used to do, silently, because a headless session cannot open Claude
# Code's own permission dialog. opencode's edits are matched the same way; a
# change to several files at once goes through only if every one of them may.
#
# This is the one thing Halyard permits without a person, so it is empty by
# default and every grant is written to the audit log with the pattern that
# allowed it. Patterns are matched *inside the project the write belongs to*,
# never against the whole machine: `NOTES/**` means `NOTES/**` of whichever
# gated project the agent is working in. A path that climbs out with `..`, or
# through a symlink, is refused however it is spelled.
#
#   NOTES/**        everything under NOTES, at any depth
#   NOTES           the same thing, written shorter
#   NOTES/*.md      Markdown directly in NOTES, and no deeper
#
# The gate's own files ask whatever the pattern says: `.git/`, and where the
# runtimes read their hooks from — `.claude/`, `.codex/`, `.opencode/` with
# `opencode.json`, `.zcode/`, `.agents/` — in any case, at any depth. So even
# `**` cannot let an agent switch the gate off without a card.
#
# writes:
#   - NOTES/**

# Tools that may run without being asked.
#
# The gate also covers MCP tools, `WebFetch` and `WebSearch` — at the desk those
# are a popup, and from a phone they used to be denied with nothing to answer.
# An MCP server is mostly read-only queries, though, and one analysis turn calls
# them dozens of times, so name the ones that need not ask.
#
# Matched as globs against the tool's name. `mcp__*__list_*` covers the same
# tool on a local server and a production one, which is how these are deployed.
#
# `Bash` cannot be granted here, and neither can `Write`/`Edit` — a shell
# command is what the gate is for, and a write is granted by its destination
# under `writes:` above. A pattern wide enough to reach them is refused.
#
# tools:
#   - mcp__*__list_*
#   - mcp__*__get_*

# Jobs Halyard does about itself, run from the terminal — Halyard is not a
# project, and nothing here is wired. `runs-advice` reads the cards a project
# still asks and has a model propose what it could trust under `runs:`; every
# count is Halyard's, and you add what you agree with. docs/upkeep.md.
#
#   make runs-advice p=alpha-engine
#
# upkeep:
#   runs-advice:
#     model: opus          # HALYARD_INSPECTION_MODEL when unset
#     effort: high
#     days: 14

# Sentences you say often enough to want a name for. Each key becomes a
# command, so this one is `/md`, and anything typed after it is added on the
# end — `/md the failing test` arrives as the prompt with that appended.
#
# The one below exists because a phone is bad at moving text. A long answer
# arrives split into three messages, and handing it to another agent means
# copying each piece — while that agent reads the first one, decides a message
# has arrived, and starts working on a third of the instruction. So do not move
# the text: ask the agent that already has it to write a file, and pass the path.
#
# Leave this out entirely and `/md` still works, with wording that assumes
# nothing about where files live here. Replace it with yours.

prompts:
  md: >-
    Write what you just produced to a Markdown file under
    NOTES/development-prompts, in whichever place fits, and reply with the
    path and nothing else.

# Agents, arranged by the project they work in.
#
# Once a project has a `path`, wiring takes its name rather than a directory:
#     halyard wire alpha-engine
#     halyard unwire alpha-engine

projects:
  alpha-engine:
    # Where `halyard wire` puts the gate.
    path: ~/code/alpha-engine
    # Put each agent's label on the task its branch is for — `navigator:claude`,
    # `reviewer:codex` — the first time that agent works on it. Needs a forge
    # token that may label issues; off unless set. See docs/setup.md.
    # label_work: true
    # What `/command` offers, by name. `validate:` and a transition's `commands:`
    # name entries from here rather than a command line of their own.
    # commands:
    #   test-fast: make test-fast
    #   e2e: make test-e2e SCOPE={label_groups.area}   # the task's `area` label; asked for if missing
    #   cleanup: make cleanup
    #   pull-branch: make pull-branch TASK={input.task}   # typed when /command runs it
    #   next-task: [cleanup, pull-branch]              # a list: one after another, stops at a failure
    # validate: test-fast             # run first by /review_and_commit
    # Commands an agent may run here without a card, written as they are typed.
    # They run this project's code, so they are never taken for reads; this says
    # you trust them. A last `*` takes further arguments — options, and paths
    # inside the project — and `NAME=*` says that setting may be given. Only with
    # HALYARD_ALLOW_RISK_AT_OR_BELOW on. An entry that could run anything
    # (`bash *`, `python -c *`, `uv run *`, `make *`) is ignored, and doctor says so.
    # `halyard rules add` keeps more without editing this file, and `halyard rules
    # export` / `import` carry the whole list to another machine.
    # runs:
    #   - make test-fast
    #   - make lint-be
    #   - UV_CACHE_DIR=* uv run pytest *
    #   - uv run --package * pytest *
    #   - npx vitest run *
    # Inspections `/inspect` offers over a chat's last reply, and transitions
    # `/transition` offers — each the project's own file, read relative to `path`. A
    # transition carries the last reply, puts its prompt in front, runs its commands
    # and then the inspections it names under `inspect:`, and goes to the agent or
    # role in `to:` (every agent is offered if unset). All of it is described in
    # docs/transitions.md. Written `checks:` before 2026-09-23 and `handoffs:`
    # before 2026-09-24, which still work.
    # inspections:
    #   proof: NOTES/halyard/inspections/proof.md
    #   destructive: NOTES/halyard/inspections/destructive.md
    #   bounded-context:                 # one that runs on a model of its own
    #     file: NOTES/halyard/inspections/bounded-context.md
    #     model: opus                    # effort: too; what it leaves out is the machine's
    # transitions:
    #   reviewed: {to: navigator}        # the reply alone, with no prompt of its own
    #   review:
    #     prompt: NOTES/halyard/transitions/review.md
    #     followup_prompt: NOTES/halyard/transitions/review-followup.md   # a workflow step's round 2 on
    #     to: reviewer
    #   driver_discover: {prompt: NOTES/halyard/transitions/forward.md, to: driver}
    #   driver_develop: {prompt: NOTES/halyard/transitions/forward.md, to: driver}
    #   discover_completed:
    #     prompt: NOTES/halyard/transitions/discovery.md
    #     inspect: [proof, destructive]
    #     to: navigator
    #   close:
    #     prompt: NOTES/halyard/transitions/close.md
    #     commands: [test-fast]          # from `commands:`, run before the inspections
    #     inspect: [proof, destructive]
    #     to: navigator
    # Workflows take those transitions in an order, each step to an agent, and go on by
    # the last line of each reply: forward, back or wait. A step goes once unless
    # `rounds:` says more. A list inside a workflow is its phases: the steps a plan
    # in parts goes through once per part, whose last step says `next` for another
    # phase — or `next develop` to start it further on — and `forward` to leave
    # them. See docs/workflows.md.
    # workflows:
    #   decisions: {forward: forward, back: back, wait: wait, next: next}   # the defaults
    #   phases: 3                        # how many phases go before it stops and asks
    #   steps:
    #     review: {agent: reviewer, rounds: 2}
    #     reviewed: {agent: navigator, decided_by: review, rounds: 2}
    #     discover: {transition: driver_discover, agent: driver, rounds: 2}
    #     discovered: {transition: discover_completed, agent: navigator, rounds: 2}
    #     develop: {transition: driver_develop, agent: driver}
    #     verified: {transition: reviewed, agent: navigator}
    #     close: {agent: navigator}
    #   level3: [review, reviewed, [discover, discovered, develop, verified], close]
    # Groups of task labels. The first one the task carries from each group
    # goes on the envelope inspections and transitions are given, as `level: level::3`.
    # Nothing is required or refused: a task with none of them adds nothing.
    # label_groups:
    #   level: [level::1, level::2, level::3]
    #   area: [area:api, area:web, area:all]   # a command can take one: {label_groups.area}
    # What the inspections' answers say when they found something, in the
    # project's own words — quoted, since a phrase with a colon is otherwise a
    # mapping. An answer saying one of them puts `halyard:<inspection>` on the task. This writes
    # to the tracker, so nothing is written unless it is set.
    # label_findings:
    #   - "status: candidate"
    #   - "status: evidence missing"
    # Written `seats:` before 2026-09-24, and a step's `agent:` was `seat:`;
    # both still work.
    agents:
      # A label is what you type on a phone. It has to be unique across every
      # project, because it is also how `doctor` names an agent.
      nav:
        runtime: claude-code
        # What survives a compaction, for the agents where it matters. A
        # navigator holding a plan across a day needs this; a driver running
        # one command does not, and is left alone by leaving these out.
        #
        #   before_compaction  instructions for the record Halyard writes
        #                      *about* this session as it is compacted — a
        #                      separate one-shot turn reads the transcript, so
        #                      the session itself is never resumed or forked.
        #   after_compaction   handed to the session once the summary is done,
        #                      when it has to work out what it was doing.
        #
        # Both are files, relative to the Halyard checkout. Measured: a hook
        # cannot steer the summary itself — `PreCompact` output is refused by
        # the runtime — so this is the shape that actually works.
        #
        # What to put in them, learned from a navigator reporting on the
        # compaction it had just come out of:
        #
        #   Write facts, not errands. Its standing rules survived and caught a
        #   delegate's false report. The part listing which files to open did
        #   not: a message from the operator arrived, pulled it into the work,
        #   and the reading list lost. Reading is a decision; text is already
        #   there. Three lines of "the active job is X, the last measurements
        #   are Y" beat any number of "now go and open Z".
        #
        #   Lead with what is unfinished. A summary keeps history rather well
        #   and loses work in flight — a report received and never checked, a
        #   command run whose output was never read, a question waiting on an
        #   answer. That is the part worth spending the space on.
        #
        #   Keep it short. Every line costs context and brings the next
        #   compaction closer, and a long list teaches the reader to skip lists.
        #
        # before_compaction: compaction_hook/alpha_engine/precompact.md
        # after_compaction: compaction_hook/alpha_engine/postcompact.md
        # The name the runtime knows the session by. `halyard sessions` lists
        # the ones this machine can see; a Codex thread id works too.
        session: alpha-engine-navigator
        # Quoted, because -1001 unquoted is a number to YAML and a string
        # everywhere else — and the mismatch routes nowhere, silently.
        # A forum topic inside a group is "-1001:12".
        chat: "-1001234567890"
        # Optional. It colours the card and matches a hook that declares one.
        # Two agents may share a role; that is the point of having four.
        role: navigator
        # Optional. The label this agent puts on a task when `label_work` is on —
        # role and runtime unless set, `navigator:claude`, or `claude` alone for a
        # agent with no role. Set it to match labels your tracker already uses.
        # Leave the model out: that changes under an agent, and this never does.
        # task_label: navigator:agent

      drv:
        runtime: claude-code
        session: alpha-engine-driver
        chat: "-1002234567890"
        role: driver

      xnav:
        runtime: codex
        session: alpha-engine-xnavigator
        chat: "-1003234567890"
        role: navigator

      xdrv:
        runtime: codex
        session: alpha-engine-xdriver
        chat: "-1004234567890"
        role: driver

      # A reviewer is an agent like the others. Hand it work with `/forward`
      # from the agent that wrote it; its cards go to its own chat.
      xrev:
        runtime: codex
        session: alpha-engine-xreviewer
        chat: "-1005234567890"
        role: reviewer

  # A second project is a second block. An agent with no `chat` is reachable by
  # name and has nowhere of its own to speak, which is enough to hand it work.
  # hermes:
  #   path: ~/code/hermes
  #   agents:
  #     hnav:
  #       runtime: codex
  #       session: hermes-navigator
  #       chat: "-2001234567890"
