# Everything Halyard needs on this machine: what it talks to, and who it
# talks for.
#
# Copy to `halyard.yaml` and edit. It is gitignored, along with every backup
# Halyard takes of it, because the bot token lives here.
#
# `halyard init` writes this file for you and can wire a project afterwards.
# Editing it by hand is the same thing more slowly.
#
# A real environment variable still wins over anything below — that is how a
# container passes a token in without writing it to disk. There is no second
# file: `.env` used to hold the settings while this held the seats, which meant
# two files describing one machine and no rule for which of them won.

settings:
  # Where approvals go. `telegram` is the only one that asks a person.
  HALYARD_CHANNEL: telegram

  # From @BotFather. Secret — this is the line the gitignore is for.
  TELEGRAM_BOT_TOKEN: "123456:replace-me"
  # Where anything unrouted lands.
  TELEGRAM_CHAT_ID: "-1001234567890"
  # Only these Telegram users can answer an approval. Everyone else is
  # refused and the attempt is written to the audit log.
  TELEGRAM_AUTHORIZED_USER_IDS: "11111111"

  # The credential the turns Halyard starts run on.
  #
  # Without this they use the login you made at the keyboard, and that login
  # expires and cannot always be refreshed — which stops remote deliveries
  # until somebody signs in at the desk, the one thing you are away from.
  #
  # Mint one with:  claude setup-token
  # It uses your subscription rather than pay-as-you-go API billing, and lasts
  # about a year. Secret, like the token above — this is what the gitignore is
  # for. A session you drive at the keyboard is untouched by this.
  #
  # HALYARD_CLAUDE_OAUTH_TOKEN: "sk-ant-oat01-replace-me"
  #
  # Note: ANTHROPIC_API_KEY, if it is set anywhere in the environment, outranks
  # the token and bills the API instead of your plan. `halyard doctor` says so.

  # What a card calls this codebase.
  CLAUDE_PROJECT_NAME: alpha-engine

  # The address the control plane binds, and the one every hook derives from.
  HALYARD_BIND: 127.0.0.1:8787

  # An approval nobody answers in this many seconds is DENIED, not left
  # waiting. These three have to stay in this order — the control plane
  # refuses to start otherwise — so a hook cannot give up before the person
  # it is waiting for has had their time.
  HALYARD_APPROVAL_TIMEOUT_SECONDS: 300
  HALYARD_BRIDGE_TIMEOUT_SECONDS: 330
  HALYARD_HOOK_TIMEOUT_SECONDS: 600

  # Serving holds an idle-sleep assertion on macOS, because a control plane
  # that sleeps denies every command on the machine and says nothing.
  # HALYARD_KEEP_AWAKE: false

# Paths the agent may write to without being asked.
#
# The gate covers `Write` and `Edit`, so a write to anywhere else puts a card
# on your phone rather than failing — which is what a turn started from the
# phone used to do, silently, because a headless session cannot open Claude
# Code's own permission dialog.
#
# This is the one thing Halyard permits without a person, so it is empty by
# default and every grant is written to the audit log with the pattern that
# allowed it. Patterns are matched *inside the project the write belongs to*,
# never against the whole machine: `NOTES/**` means `NOTES/**` of whichever
# gated project the agent is working in. A path that climbs out with `..`, or
# through a symlink, is refused however it is spelled.
#
#   NOTES/**        everything under NOTES, at any depth
#   NOTES           the same thing, written shorter
#   NOTES/*.md      Markdown directly in NOTES, and no deeper
#
# writes:
#   - NOTES/**

# Tools that may run without being asked.
#
# The gate also covers MCP tools, `WebFetch` and `WebSearch` — at the desk those
# are a popup, and from a phone they used to be denied with nothing to answer.
# An MCP server is mostly read-only queries, though, and one analysis turn calls
# them dozens of times, so name the ones that need not ask.
#
# Matched as globs against the tool's name. `mcp__*__list_*` covers the same
# tool on a local server and a production one, which is how these are deployed.
#
# `Bash` cannot be granted here, and neither can `Write`/`Edit` — a shell
# command is what the gate is for, and a write is granted by its destination
# under `writes:` above. A pattern wide enough to reach them is refused.
#
# tools:
#   - mcp__*__list_*
#   - mcp__*__get_*

# Sentences you say often enough to want a name for. Each key becomes a
# command, so this one is `/md`, and anything typed after it is added on the
# end — `/md the failing test` arrives as the prompt with that appended.
#
# The one below exists because a phone is bad at moving text. A long answer
# arrives split into three messages, and handing it to another agent means
# copying each piece — while that agent reads the first one, decides a message
# has arrived, and starts working on a third of the instruction. So do not move
# the text: ask the agent that already has it to write a file, and pass the path.
#
# Leave this out entirely and `/md` still works, with wording that assumes
# nothing about where files live here. Replace it with yours.

prompts:
  md: >-
    Write what you just produced to a Markdown file under
    NOTES/development-prompts, in whichever place fits, and reply with the
    path and nothing else.

# Seats, arranged by the project they work in.
#
# Once a project has a `path`, wiring takes its name rather than a directory:
#     halyard wire alpha-engine
#     halyard unwire alpha-engine

projects:
  alpha-engine:
    # Where `halyard wire` puts the gate.
    path: ~/code/alpha-engine
    seats:
      # A label is what you type on a phone. It has to be unique across every
      # project, because it is also how `doctor` names a seat.
      nav:
        runtime: claude-code
        # What survives a compaction, for the seats where it matters. A
        # navigator holding a plan across a day needs this; a driver running
        # one command does not, and is left alone by leaving these out.
        #
        #   before_compaction  instructions for the record Halyard writes
        #                      *about* this session as it is compacted — a
        #                      separate one-shot turn reads the transcript, so
        #                      the session itself is never resumed or forked.
        #   after_compaction   handed to the session once the summary is done,
        #                      when it has to work out what it was doing.
        #
        # Both are files, relative to the Halyard checkout. Measured: a hook
        # cannot steer the summary itself — `PreCompact` output is refused by
        # the runtime — so this is the shape that actually works.
        #
        # What to put in them, learned from a navigator reporting on the
        # compaction it had just come out of:
        #
        #   Write facts, not errands. Its standing rules survived and caught a
        #   delegate's false report. The part listing which files to open did
        #   not: a message from the operator arrived, pulled it into the work,
        #   and the reading list lost. Reading is a decision; text is already
        #   there. Three lines of "the active job is X, the last measurements
        #   are Y" beat any number of "now go and open Z".
        #
        #   Lead with what is unfinished. A summary keeps history rather well
        #   and loses work in flight — a report received and never checked, a
        #   command run whose output was never read, a question waiting on an
        #   answer. That is the part worth spending the space on.
        #
        #   Keep it short. Every line costs context and brings the next
        #   compaction closer, and a long list teaches the reader to skip lists.
        #
        # before_compaction: compaction_hook/alpha_engine/precompact.md
        # after_compaction: compaction_hook/alpha_engine/postcompact.md
        # The name the runtime knows the session by. `halyard sessions` lists
        # the ones this machine can see; a Codex thread id works too.
        session: alpha-engine-navigator
        # Quoted, because -1001 unquoted is a number to YAML and a string
        # everywhere else — and the mismatch routes nowhere, silently.
        # A forum topic inside a group is "-1001:12".
        chat: "-1001234567890"
        # Optional. It colours the card and matches a hook that declares one.
        # Two seats may share a role; that is the point of having four.
        role: navigator

      drv:
        runtime: claude-code
        session: alpha-engine-driver
        chat: "-1002234567890"
        role: driver

      xnav:
        runtime: codex
        session: alpha-engine-xnavigator
        chat: "-1003234567890"
        role: navigator

      xdrv:
        runtime: codex
        session: alpha-engine-xdriver
        chat: "-1004234567890"
        role: driver

  # A second project is a second block. A seat with no `chat` is reachable by
  # name and has nowhere of its own to speak, which is enough to hand it work.
  # hermes:
  #   path: ~/code/hermes
  #   seats:
  #     hnav:
  #       runtime: codex
  #       session: hermes-navigator
  #       chat: "-2001234567890"
