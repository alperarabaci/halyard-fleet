# Environment and secrets
.env
.env.local

# Every backup any Halyard command takes, whatever it was backing up.
#
# A pattern per file was one pattern short: `halyard.yaml` was ignored and
# `halyard.yaml.20260725-181153.bak` was not, and that file holds the bot
# token — `halyard init` copies the old document aside before writing, so a
# secret this repository is careful never to log was one `git add -A` from
# being published. Nothing was committed; the rule is here so nothing can be.
*.bak

# Runtime state (never committed)
halyard.db
halyard.db-shm
halyard.db-wal
audit.jsonl

# Local Claude Code settings (may contain machine-specific hook wiring)
.claude/settings.local.json
# Same reason: an absolute path to this machine's Halyard checkout.
.codex/hooks.json
.claude/settings.local.json.*.bak
.codex/hooks.json.*.bak

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors and OS
.DS_Store
.idea/
.vscode/

# Design conversation exports (kept locally, not published)
docs/mobile-agent-control-plane.md


# Running log
halyard.log
halyard.log.*

# What the bridge writes down about its own runs
bridge.log

# Saved copies of third-party docs, kept locally while researching
hooks.html

# Your own machine: the bot token, chat ids, session names, and the seats of
# every project it gates. One file describes all of it.
halyard.yaml
halyard.yml
